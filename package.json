{
  "name": "into-youth-archive",
  "version": "3.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vps-app/vite.config.mjs",
    "build": "vite build --config vps-app/vite.config.mjs",
    "build:vps": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:server": "python -m unittest discover -s tests -p \"test_*.py\"",
    "check:public": "python scripts/check_public.py",
    "lint": "eslint app components vps-app --ignore-pattern vps-dist"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-advanced-cropper": "^0.20.1",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "pixi.js": "6.5.10",
    "pixi-live2d-display": "0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "6.3.0"
    }
  }
