[Unit]
Description=Memory Archive Archive API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/memory-archive.env
ExecStart=/usr/bin/python3 /opt/memory-archive/server/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/memory-archive/data /opt/memory-archive/uploads

[Install]
WantedBy=multi-user.target
